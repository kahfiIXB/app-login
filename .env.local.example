# Salin file ini menjadi .env.local lalu sesuaikan jika perlu
# Default ini cocok untuk MySQL bawaan Laragon (user root, tanpa password)

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=auth_app

# Ganti dengan string acak/rahasia untuk produksi
JWT_SECRET=ganti_dengan_string_rahasia_kamu_sendiri
